{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./source/*"
      ]
    },
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "source",
    "app",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
